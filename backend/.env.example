# Spring Boot and Docker local development configuration.
# Copy to .env and replace every placeholder before a shared deployment.
# This file is safe to commit: never put a real password, API key or app password here.
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/copilote_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-starting

# Must be identical to engineering-copilot-ai-main/.env.
AI_INTERNAL_API_KEY=change-this-to-a-long-random-secret
AI_SERVICE_BASE_URL=http://localhost:8000
DOCUMENT_STORAGE_PATH=./storage/documents

# SMTP email delivery. For Gmail, use an app password, not your normal account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
