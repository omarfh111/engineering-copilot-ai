# Spring Boot and Docker local development configuration.
# Copy to .env and replace every placeholder before a shared deployment.
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/copilote_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-starting

# Must be identical to engineering-copilot-ai-main/.env.
AI_INTERNAL_API_KEY=change-this-to-a-long-random-secret
AI_SERVICE_BASE_URL=http://localhost:8000
DOCUMENT_STORAGE_PATH=./storage/documents
