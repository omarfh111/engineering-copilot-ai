# Copy to backend/.env for local development. Do not commit backend/.env.
AI_SERVICE_BASE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=replace-with-a-long-random-value
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/copilote_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-me
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_PASSWORD=replace-me
