# Application
APP_NAME=Engineering Copilot AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# LangSmith - laisser les clés vides si le tracing n'est pas utilisé
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=engineering-copilot-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Providers
LLM_PROVIDER=openai
VECTOR_DB=qdrant
GIT_PROVIDER=github

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Ollama - réservé aux expérimentations locales
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:8b

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_API_KEY=

# PostgreSQL - requis par la configuration, non utilisé par les routes RAG actuelles
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=engineering_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=exp_openai_text_embedding_3_small
VECTOR_COLLECTION=exp_openai_text_embedding_3_small

# GitHub - réservé aux futures fonctions d'analyse de repository
GITHUB_TOKEN=

# Paramètres IA
TOP_K=10
MAX_CONTEXT_DOCUMENTS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
